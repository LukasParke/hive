{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "prisma generate && vite build",
		"build:launcher": "esbuild scripts/launcher.ts --bundle --platform=node --target=node22 --outfile=dist/launcher.js --format=esm --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/dockerode": "^4.0.1",
		"@types/js-yaml": "^4.0.9",
		"@types/pg": "^8.18.0",
		"esbuild": "^0.25.0",
		"prisma": "^7.8.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.4.2",
		"@sveltejs/adapter-node": "^5.5.4",
		"@tailwindcss/vite": "^4.2.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"better-auth": "^1.5.2",
		"chart.js": "^4.5.1",
		"dockerode": "^4.0.9",
		"js-yaml": "^4.1.1",
		"pg": "^8.19.0",
		"svelte-sonner": "^1.0.7",
		"tailwindcss": "^4.2.1",
		"ws": "^8.19.0"
	}
}
