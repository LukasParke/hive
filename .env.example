# Hive Environment Variables
# Copy to .env and adjust for your environment.

# ── Core ──────────────────────────────────────────────────────────────
# Role this instance plays: manager | engine | agent
HIVE_ROLE=manager

# Enable development mode
# HIVE_DEV=1

# Persistent data directory (password files, NATS store, etc.)
HIVE_DATA_DIR=/data

# ── Database ──────────────────────────────────────────────────────────
# Postgres connection string (auto-populated by bootstrap in managed mode)
# DATABASE_URL=postgres://hive:secret@hive-postgres:5432/hive?sslmode=disable

# Bring your own managed PostgreSQL (launcher skips deploying hive-postgres)
# EXTERNAL_DATABASE_URL=postgres://user:pass@your-db-host:5432/hive

# ── Auth (BetterAuth) ────────────────────────────────────────────────
# Secret used to sign session tokens (auto-generated if not set)
# BETTER_AUTH_SECRET=your-secret-here

# Base URL for the SvelteKit app (used by BetterAuth for callbacks)
# BETTER_AUTH_URL=http://localhost:8080

# Encryption key for sensitive data stored in the database (64 hex chars = 32 bytes AES-256)
# Must match the Go engine's HIVE_ENCRYPTION_KEY. Auto-generated if not set in dev mode.
# HIVE_ENCRYPTION_KEY=

# ── Hive Engine (internal Go API) ────────────────────────────────────
# Internal URL to reach hive-engine (only used by SvelteKit)
# HIVE_ENGINE_URL=http://hive-engine:9090

# Shared secret for SvelteKit <-> hive-engine auth
# HIVE_ENGINE_SECRET=

# ── Networking / Ports ────────────────────────────────────────────────
# SvelteKit server port (user-facing)
PORT=8080

# NATS URL for engine/agents to connect to the standalone NATS service
HIVE_NATS_URL=nats://hive-nats:4222

# ── Docker / Swarm ───────────────────────────────────────────────────
# Docker socket path
# DOCKER_HOST=unix:///var/run/docker.sock

# Docker image reference (used for self-deploy and agent deployment)
HIVE_IMAGE=127.0.0.1:5000/hive:latest

# Set to "true" when running as a Swarm-managed service (set automatically)
# HIVE_MANAGED=true

# Public URL of this Hive installation (used by BetterAuth and webhooks)
# HIVE_URL=https://hive.example.com

# ── Ingress / Cloudflare ─────────────────────────────────────────────
# Ingress mode: port_forward | cloudflare_tunnel | both
HIVE_INGRESS_MODE=port_forward

# Cloudflare API token (required for DNS challenges and tunnels)
# HIVE_CF_API_TOKEN=

# Cloudflare tunnel token (for cloudflare_tunnel ingress mode)
# HIVE_CF_TUNNEL_TOKEN=

# Cloudflare zone ID
# HIVE_CF_ZONE_ID=

# ── Registry ─────────────────────────────────────────────────────────
# Private registry domain (deployed automatically in multi-node mode)
HIVE_REGISTRY_DOMAIN=registry.hive.local

# Allow insecure (HTTP) registry communication
HIVE_REGISTRY_INSECURE=true

# ── Monitoring ───────────────────────────────────────────────────────
# Agent metrics collection interval in seconds
HIVE_AGENT_INTERVAL=10

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (empty = allow request origin)
# HIVE_ALLOWED_ORIGINS=https://hive.example.com

# ── Webhooks ─────────────────────────────────────────────────────────
# Public base URL for git provider webhook callbacks
# HIVE_WEBHOOK_BASE_URL=https://hive.example.com
