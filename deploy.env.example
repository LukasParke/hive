# Remote deployment configuration
# Copy to deploy.env and adjust for your environment:
#   cp deploy.env.example deploy.env

# SSH target (Swarm manager node)
REMOTE_HOST=10.10.10.51
REMOTE_USER=luke

# Directory on the remote host where source is synced for builds
REMOTE_DIR=~/hive-dev

# Swarm-local registry used by all nodes to pull images
REGISTRY=127.0.0.1:5000

# Image name (tagged as $REGISTRY/$IMAGE:latest)
IMAGE=hive

# Public URL where the Hive UI is accessed (used for auth origin validation)
# HIVE_URL=http://your-node-ip-or-domain

# ── PostgreSQL HA ─────────────────────────────────────────────────────
# Hive deploys a 3-node PostgreSQL HA cluster automatically:
#   - bitnamilegacy/postgresql-repmgr (one per Swarm manager, sync replication)
#   - Repmgr handles automatic failover and standby re-sync
#
# Services: hive-pg-0 (primary), hive-pg-1, hive-pg-2 (standbys)
# Data volumes: hive-pg-{n}-data (local on each node)
# Connection: apps connect to hive-pg-0:5432 (initial primary)
#
# To skip the built-in HA cluster and use your own database, set:
# EXTERNAL_DATABASE_URL=postgres://user:pass@your-db:5432/hive
