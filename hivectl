#!/usr/bin/env bash
set -euo pipefail

# Hive Platform Control Script
# Usage: ./hivectl <command> [options]
#
# Commands:
#   install      Install or re-install the Hive platform
#   update       Update Hive to a newer version
#   uninstall    Remove the Hive stack
#   status       Show Hive stack status
#   logs         Tail control-plane logs
#
# Environment:
#   HIVE_DOMAIN             Optional domain for the platform (e.g. hive.example.com)
#   ACME_EMAIL              Email for Let's Encrypt certificates when HIVE_DOMAIN is set
#   HIVE_IMAGE_TAG          Image tag to deploy (default: latest)
#   HIVE_CONTROL_PLANE_IMAGE Control-plane image (default: ghcr.io/lukasparke/hive/control-plane)
#   HIVE_AGENT_IMAGE        Agent image (default: ghcr.io/lukasparke/hive/agent)
#   HIVE_DIRECT_PORT        Direct HTTP UI port for LAN/Cloudflare Tunnel (default: 8080)
#   HIVE_CONTROL_PLANE_PORT Direct control-plane port (default: 3000)
#   HIVE_HEALTH_HOST        Host used for install/status API probes (default: detected swarm node IP)
#   HIVE_TRAEFIK_ENABLE     Enable Traefik domain routing (default: true when HIVE_DOMAIN is set)
#   HIVE_STACK_FILE         Path to stack file (default: deploy/hive-stack.yml)
#   HIVE_STACK_URL          URL to stack file when running via curl pipe
#   HIVE_STACK_NAME         Docker stack name (default: hive)

SCRIPT_PATH="${BASH_SOURCE[0]:-}"
if [ -n "$SCRIPT_PATH" ] && [ -f "$SCRIPT_PATH" ]; then
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
else
  SCRIPT_DIR="$(pwd)"
fi

DEFAULT_STACK_FILE="${SCRIPT_DIR}/deploy/hive-stack.yml"
STACK_FILE="${HIVE_STACK_FILE:-$DEFAULT_STACK_FILE}"
HIVE_RAW_BASE="${HIVE_RAW_BASE:-https://raw.githubusercontent.com/LukasParke/hive/main}"
HIVE_STACK_URL="${HIVE_STACK_URL:-${HIVE_RAW_BASE}/deploy/hive-stack.yml}"
STACK_NAME="${HIVE_STACK_NAME:-hive}"
DIRECT_PORT="${HIVE_DIRECT_PORT:-8080}"
CONTROL_PLANE_PORT="${HIVE_CONTROL_PLANE_PORT:-3000}"
HIVE_HEALTH_HOST="${HIVE_HEALTH_HOST:-}"
TEMP_FILES=()

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() { echo -e "${BLUE}ℹ${NC}  $*"; }
ok() { echo -e "${GREEN}✓${NC}  $*"; }
warn() { echo -e "${YELLOW}⚠${NC}  $*" >&2; }
error() { echo -e "${RED}✗${NC}  $*" >&2; }

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

cmd_exists() { command -v "$1" >/dev/null 2>&1; }

cleanup() {
  if [ "${#TEMP_FILES[@]}" -gt 0 ]; then
    rm -f "${TEMP_FILES[@]}"
  fi
}
trap cleanup EXIT

read_prompt() {
  local var="$1" prompt="$2"
  if [ -r /dev/tty ]; then
    read -r -p "$prompt" "$var" </dev/tty
  else
    read -r -p "$prompt" "$var"
  fi
}

download_file() {
  local url="$1" dest="$2"
  if cmd_exists curl; then
    curl -fsSL "$url" -o "$dest"
  elif cmd_exists wget; then
    wget -qO "$dest" "$url"
  else
    error "curl or wget is required to download ${url}"
    return 1
  fi
}

ensure_stack_file() {
  if [ -f "$STACK_FILE" ]; then
    return 0
  fi

  if [ -n "${HIVE_STACK_FILE:-}" ]; then
    error "Stack file not found: ${STACK_FILE}"
    exit 1
  fi

  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/hive-stack.XXXXXX.yml")"
  TEMP_FILES+=("$tmp")

  info "Downloading stack file from ${HIVE_STACK_URL}"
  download_file "$HIVE_STACK_URL" "$tmp"
  STACK_FILE="$tmp"
}

require_docker() {
  if ! cmd_exists docker; then
    error "Docker is required but not installed."
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    error "Docker daemon is not running or you lack permissions."
    exit 1
  fi
}

swarm_active() {
  docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null | grep -q active
}

ensure_swarm() {
  if swarm_active; then
    ok "Docker Swarm is active"
    return 0
  fi
  info "Initializing Docker Swarm..."
  docker swarm init 2>/dev/null || docker swarm init --advertise-addr "$(hostname -i | awk '{print $1}')" 2>/dev/null || true
  if ! swarm_active; then
    error "Failed to initialize Docker Swarm"
    exit 1
  fi
  ok "Docker Swarm initialized"
}

stack_exists() {
  docker stack ls --format '{{.Name}}' 2>/dev/null | grep -qx "${STACK_NAME}"
}

service_image_tag() {
  local svc="$1"
  local img
  img=$(docker service inspect --format='{{.Spec.TaskTemplate.ContainerSpec.Image}}' "${STACK_NAME}_${svc}" 2>/dev/null || true)
  if [ -n "$img" ]; then
    echo "$img" | sed 's/.*://' | sed 's/@.*//'
  else
    echo "unknown"
  fi
}

release_legacy_traefik_direct_port() {
  local svc="${STACK_NAME}_traefik"
  if ! docker service inspect "$svc" >/dev/null 2>&1; then
    return 0
  fi

  local ports
  ports="$(docker service inspect --format '{{range .Endpoint.Spec.Ports}}{{printf "%d:%d/%s\n" .PublishedPort .TargetPort .Protocol}}{{end}}' "$svc" 2>/dev/null || true)"
  if ! printf '%s\n' "$ports" | grep -qx "${DIRECT_PORT}:8080/tcp"; then
    return 0
  fi

  warn "Repairing previous Traefik direct-port binding on :${DIRECT_PORT}"
  if docker service update --publish-rm 8080 "$svc" >/dev/null; then
    for ((i = 0; i < 30; i += 2)); do
      ports="$(docker service inspect --format '{{range .Endpoint.Spec.Ports}}{{printf "%d:%d/%s\n" .PublishedPort .TargetPort .Protocol}}{{end}}' "$svc" 2>/dev/null || true)"
      if ! printf '%s\n' "$ports" | grep -qx "${DIRECT_PORT}:8080/tcp"; then
        ok "Previous Traefik direct port released"
        return 0
      fi
      sleep 2
    done
  fi

  warn "Traefik still owns :${DIRECT_PORT}; removing ${svc} so stack deploy can recreate it cleanly"
  docker service rm "$svc" >/dev/null 2>&1 || true
  for ((i = 0; i < 30; i += 2)); do
    if ! docker service inspect "$svc" >/dev/null 2>&1; then
      ok "Removed stale Traefik service"
      return 0
    fi
    sleep 2
  done

  warn "Stale Traefik service still exists; deploy may report a port conflict"
}

prompt_required() {
  local var="$1" prompt="$2"
  if [ -z "${!var:-}" ]; then
    if ! read_prompt "$var" "$prompt: "; then
      error "$var is required"
      exit 1
    fi
    export "$var"
  fi
  if [ -z "${!var:-}" ]; then
    error "$var is required"
    exit 1
  fi
}

prompt_optional() {
  local var="$1" prompt="$2"
  if [ -z "${!var:-}" ]; then
    read_prompt "$var" "$prompt: " || true
    export "$var"
  fi
}

# is_lan_ip filters out loopback, link-local, and Docker's default bridge
# ranges, which are reachable only from the host itself.
is_lan_ip() {
  case "$1" in
    ""|0.0.0.0|"<no value>") return 1 ;;
    127.*|169.254.*|172.17.*|172.18.*|172.19.*|172.20.*|172.21.*|172.22.*|172.23.*|172.24.*|172.25.*|172.26.*|172.27.*|172.28.*|172.29.*|172.30.*|172.31.*) return 1 ;;
  esac
  return 0
}

detect_host_ip() {
  local ip
  ip="$(docker info --format '{{.Swarm.NodeAddr}}' 2>/dev/null || true)"
  if is_lan_ip "$ip"; then
    echo "$ip"
    return 0
  fi

  ip="$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}' || true)"
  if is_lan_ip "$ip"; then
    echo "$ip"
    return 0
  fi

  for ip in $(hostname -I 2>/dev/null || true); do
    if is_lan_ip "$ip"; then
      echo "$ip"
      return 0
    fi
  done

  ip="$(hostname -i 2>/dev/null | awk '{print $1}' || true)"
  if [ -z "$ip" ] || [ "$ip" = "127.0.0.1" ]; then
    ip="localhost"
  fi
  echo "$ip"
}

print_stack_diagnostics() {
  warn "Hive did not become healthy. Docker service diagnostics:"
  docker service ls --filter "label=com.docker.stack.namespace=${STACK_NAME}" || true
  echo ""
  for svc in control-plane agent traefik postgres; do
    if docker service inspect "${STACK_NAME}_${svc}" >/dev/null 2>&1; then
      echo "=== ${STACK_NAME}_${svc} tasks ==="
      docker service ps --no-trunc "${STACK_NAME}_${svc}" || true
      echo ""
    fi
  done
  warn "Common causes: image pull failures, unhealthy database startup, occupied ports, or missing Swarm labels."
  warn "Try: docker service logs ${STACK_NAME}_control-plane --tail 100"
}

normalize_image_tag() {
  local tag="$1"
  if [ -z "$tag" ]; then
    printf '%s' ""
    return 0
  fi
  if [[ "$tag" == v* ]]; then
    printf '%s' "${tag#v}"
    return 0
  fi
  printf '%s' "$tag"
}

probe_endpoint() {
  local url="$1" timeout_sec="${2:-3}"

  if cmd_exists curl; then
    local raw status body
    raw="$(curl -sS --max-time "$timeout_sec" -w '\n%{http_code}' "$url" 2>/dev/null || true)"
    status="${raw##*$'\n'}"
    body="${raw%$'\n'${status}}"
    status="${status//$'\r'/}"
    printf '%s|%s' "$status" "$body"
    return 0
  fi

  if cmd_exists wget; then
    local body_file header_file status body
    body_file="$(mktemp "${TMPDIR:-/tmp}/hive-health-body.XXXXXX")"
    header_file="$(mktemp "${TMPDIR:-/tmp}/hive-health-headers.XXXXXX")"
    wget -q -S --timeout "$timeout_sec" -O "$body_file" "$url" 2>"$header_file" || true
    status="$(awk '/^  HTTP/{print $2}' "$header_file" | tail -n 1)"
    body="$(cat "$body_file")"
    status="${status//$'\r'/}"
    rm -f "$body_file" "$header_file"
    printf '%s|%s' "$status" "$body"
    return 0
  fi

  warn "curl or wget is required to probe endpoints"
  return 1
}

wait_for_health() {
  local url="$1" timeout_sec="${2:-120}" fail_fast_on_404="${3:-0}"
  info "Waiting for ${url} (timeout: ${timeout_sec}s)..."

  for ((i = 0; i < timeout_sec; i += 2)); do
    local probe status body
    probe="$(probe_endpoint "$url" 2 || true)"
    status="${probe%%|*}"
    body="${probe#*|}"

    if [ "$status" = "200" ] && [[ "$body" == *'"status":"ok"'* ]]; then
      ok "Service is healthy"
      return 0
    fi

    if [ "$status" = "404" ] && [ "$fail_fast_on_404" -eq 1 ]; then
      warn "Endpoint ${url} is returning HTTP 404. This often means the request is reaching the wrong service or missing Traefik routing."
      return 2
    fi

    sleep 2
  done

  warn "Health check timed out after ${timeout_sec}s for ${url}"
  return 1
}

endpoint_is_healthy() {
  local url="$1" timeout_sec="${2:-3}"

  local probe status body
  probe="$(probe_endpoint "$url" "$timeout_sec" || true)"
  status="${probe%%|*}"
  body="${probe#*|}"

  if [ "$status" = "200" ] && [[ "$body" == *'"status":"ok"'* ]]; then
    return 0
  fi
  return 1
}

wait_for_hive_health() {
  local host="${1:-${HIVE_HEALTH_HOST:-localhost}}"
  local direct_url="http://${host}:${DIRECT_PORT}/api/v1/health"
  local control_url="http://${host}:${CONTROL_PLANE_PORT}/api/v1/health"

  wait_for_health "$direct_url" 120 1
  HIVE_DIRECT_HEALTH_CHECK_STATUS=$?

  if [ "$HIVE_DIRECT_HEALTH_CHECK_STATUS" -eq 0 ]; then
    return 0
  fi

  wait_for_health "$control_url" 30 0
  HIVE_CONTROL_HEALTH_CHECK_STATUS=$?
  if [ "$HIVE_CONTROL_HEALTH_CHECK_STATUS" -eq 0 ]; then
    return 0
  fi

  print_stack_diagnostics
  return "$HIVE_CONTROL_HEALTH_CHECK_STATUS"
}

# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------

cmd_install() {
  require_docker
  ensure_swarm

  prompt_optional "HIVE_DOMAIN" "Platform domain (optional; press Enter for direct-port only)"
  if [ -n "${HIVE_DOMAIN:-}" ]; then
    prompt_required "ACME_EMAIL" "Email for Let's Encrypt certificates"
    HIVE_TRAEFIK_ENABLE="${HIVE_TRAEFIK_ENABLE:-true}"
  else
    ACME_EMAIL="${ACME_EMAIL:-admin@example.invalid}"
    HIVE_TRAEFIK_ENABLE="${HIVE_TRAEFIK_ENABLE:-false}"
    export ACME_EMAIL
    warn "No HIVE_DOMAIN set; Hive will be available on the direct HTTP port only."
  fi
  export HIVE_TRAEFIK_ENABLE

  # Create secrets
  info "Ensuring secrets exist..."
  create_secret() {
    local name="$1"
    if ! docker secret ls --format '{{.Name}}' | grep -qx "${name}"; then
      local value
      value="$(openssl rand -hex 32)"
      printf '%s' "$value" | docker secret create "$name" -
      ok "Created secret: ${name}"
    else
      ok "Secret exists: ${name}"
    fi
  }

  create_secret "hive-master-key"
  create_secret "postgres-password"
  create_secret "hive-jwt-secret"
  create_secret "agent-bootstrap-token"

  # Create overlay networks the stack references as external. Creating them
  # here keeps their names stable regardless of the stack name, which Traefik
  # and the control-plane rely on.
  info "Ensuring networks exist..."
  ensure_network() {
    local name="$1"; shift
    if ! docker network ls --format '{{.Name}}' | grep -qx "${name}"; then
      docker network create --driver overlay --attachable "$@" "$name" >/dev/null
      ok "Created network: ${name}"
    else
      ok "Network exists: ${name}"
    fi
  }

  ensure_network "hive_internal" --opt encrypted=true
  ensure_network "hive_proxy"

  # Label nodes for placement
  info "Labeling nodes..."
  local first_node
  first_node="$(docker node ls --format '{{.ID}}' | head -n 1)"
  docker node update --label-add db=true "$first_node" >/dev/null 2>&1 || true
  docker node update --label-add builder=true "$first_node" >/dev/null 2>&1 || true
  docker node update --label-add registry=true "$first_node" >/dev/null 2>&1 || true
  ok "Node labels set"

  # Normalize optional tag (docs historically mix v-prefixed and unprefixed release names)
  if [ -n "${HIVE_IMAGE_TAG:-}" ]; then
    HIVE_IMAGE_TAG="$(normalize_image_tag "$HIVE_IMAGE_TAG")"
  fi

  # Deploy stack
  ensure_stack_file
  release_legacy_traefik_direct_port
  info "Deploying stack with image tag: ${HIVE_IMAGE_TAG:-latest}..."
  docker stack deploy -c "$STACK_FILE" "$STACK_NAME"
  ok "Stack deployed"

  # Wait for health
  local health_host
  health_host="${HIVE_HEALTH_HOST:-$(detect_host_ip)}"
  if ! wait_for_hive_health "$health_host"; then
    error "Hive was deployed but did not become healthy. See diagnostics above."
    error "Once fixed, re-run this install — it is idempotent."
    exit 1
  fi

  info ""
  ok "Hive is installed!"
  info "  Control-plane API health: http://${health_host}:${CONTROL_PLANE_PORT}/api/v1/health"

  if [ "${HIVE_DIRECT_HEALTH_CHECK_STATUS:-1}" -eq 0 ]; then
    info "  Direct UI: http://${health_host}:${DIRECT_PORT}"
    info "  Direct health: http://${health_host}:${DIRECT_PORT}/api/v1/health"
    if [ -n "${HIVE_DOMAIN:-}" ]; then
      info "  Admin signup: https://${HIVE_DOMAIN}/register"
      info "  Admin signup (direct): http://${health_host}:${DIRECT_PORT}/register"
    else
      info "  Admin signup: http://${health_host}:${DIRECT_PORT}/register"
    fi
  else
    warn "  Direct port ${DIRECT_PORT} is not currently serving Hive"
    warn "    - check any existing service on :${DIRECT_PORT} and port exposure on this host"
    info "  Fallback UI/API: http://${health_host}:${CONTROL_PLANE_PORT}"
    info "  Admin signup: http://${health_host}:${CONTROL_PLANE_PORT}/register"
  fi
  info "  Cloudflare Tunnel target: http://localhost:${DIRECT_PORT}"
  if [ -n "${HIVE_DOMAIN:-}" ]; then
    info "  Domain URL: https://${HIVE_DOMAIN}"
    info "  Admin signup (domain): https://${HIVE_DOMAIN}/register"
  fi
}

# ---------------------------------------------------------------------------
# update
# ---------------------------------------------------------------------------

cmd_update() {
  require_docker

  if ! stack_exists; then
    error "Stack '${STACK_NAME}' is not deployed. Run './hivectl install' first."
    exit 1
  fi

  local current_cp current_agent new_tag
  current_cp="$(service_image_tag "control-plane")"
  current_agent="$(service_image_tag "agent")"

  info "Current versions:"
  info "  control-plane: ${current_cp}"
  info "  agent:         ${current_agent}"

  # Determine target version
  if [ -n "${HIVE_IMAGE_TAG:-}" ]; then
    new_tag="$(normalize_image_tag "$HIVE_IMAGE_TAG")"
    info "Using HIVE_IMAGE_TAG from environment: ${new_tag}"
  elif [ $# -gt 0 ]; then
    new_tag="$(normalize_image_tag "$1")"
    shift
  else
    # Try to fetch latest release from GitHub
    info "Checking GitHub for latest release..."
    new_tag=$(curl -sfL \
      -H "Accept: application/vnd.github+json" \
      "https://api.github.com/repos/LukasParke/hive/releases/latest" 2>/dev/null \
      | grep '"tag_name":' | sed -E 's/.*"tag_name": "([^"]+)".*/\1/') || true
    new_tag="$(normalize_image_tag "$new_tag")"

    if [ -n "$new_tag" ] && [ "$new_tag" != "null" ]; then
      info "Latest release: ${new_tag}"
    else
      warn "Could not fetch latest release from GitHub."
      if ! read_prompt new_tag "Enter image tag to update to (default: latest): "; then
        new_tag=""
      fi
      new_tag="$(normalize_image_tag "${new_tag:-latest}")"
    fi
  fi

  if [ "$current_cp" = "$new_tag" ] && [ "$current_agent" = "$new_tag" ]; then
    ok "Already running ${new_tag}"
    return 0
  fi

  info "Updating to ${new_tag}..."
  ensure_stack_file
  HIVE_IMAGE_TAG="$new_tag" docker stack deploy -c "$STACK_FILE" "$STACK_NAME"
  ok "Stack update triggered"

  # Wait for rollout
  info "Waiting for services to update..."
  for svc in control-plane agent; do
    info "  Waiting for ${svc}..."
    local attempts=0
    while [ $attempts -lt 60 ]; do
      local running desired
      running=$(docker service ps "${STACK_NAME}_${svc}" --format '{{.CurrentState}}' 2>/dev/null | grep -c 'Running' || true)
      desired=$(docker service inspect --format='{{.Spec.Mode.Replicated.Replicas}}' "${STACK_NAME}_${svc}" 2>/dev/null || echo "1")
      if [ "$svc" = "agent" ]; then
        desired=$(docker node ls --format '{{.ID}}' | wc -l)
      fi
      if [ "$running" -ge "$desired" ] 2>/dev/null; then
        ok "  ${svc} is running (${running}/${desired})"
        break
      fi
      attempts=$((attempts + 1))
      sleep 2
    done
    if [ $attempts -ge 60 ]; then
      warn "  ${svc} rollout timed out — check 'docker service ps ${STACK_NAME}_${svc}'"
    fi
  done

  ok "Update complete"
}

# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------

cmd_uninstall() {
  require_docker

  local purge=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge) purge=true; shift ;;
      *) break ;;
    esac
  done

  if ! stack_exists; then
    warn "Stack '${STACK_NAME}' does not exist"
    return 0
  fi

  if ! read_prompt confirm "Remove stack '${STACK_NAME}'? [y/N] "; then
    confirm=""
  fi
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    info "Cancelled"
    exit 0
  fi

  info "Removing stack '${STACK_NAME}'..."
  docker stack rm "$STACK_NAME" || true

  # Wait for stack removal
  local attempts=0
  while stack_exists && [ $attempts -lt 30 ]; do
    sleep 2
    attempts=$((attempts + 1))
  done

  if [ "$purge" = true ]; then
    warn "Purging volumes and secrets..."
    for vol in pgdata shared buildkit-cache registry-data agent-certs; do
      docker volume rm "${STACK_NAME}_${vol}" 2>/dev/null || true
    done
    for secret in hive-master-key postgres-password hive-jwt-secret agent-bootstrap-token; do
      docker secret rm "$secret" 2>/dev/null || true
    done
    for net in hive_internal hive_proxy; do
      docker network rm "$net" 2>/dev/null || true
    done
    ok "Purge complete"
  else
    info "Volumes and secrets preserved. Use --purge to remove them."
  fi

  ok "Hive uninstalled"
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

cmd_status() {
  require_docker

  if ! stack_exists; then
    warn "Stack '${STACK_NAME}' is not deployed"
    return 0
  fi

  echo ""
  echo "=== Stack: ${STACK_NAME} ==="
  echo ""

  echo "Services:"
  docker stack ps "$STACK_NAME" --format 'table {{.Name}}	{{.CurrentState}}	{{.Error}}' 2>/dev/null || true

  echo ""
  echo "Images:"
  local cp_tag agent_tag
  cp_tag="$(service_image_tag "control-plane")"
  agent_tag="$(service_image_tag "agent")"
  echo "  control-plane: ${cp_tag}"
  echo "  agent:         ${agent_tag}"

  echo ""
  echo "Health:"
  local status_host
  status_host="${HIVE_STATUS_HOST:-${HIVE_HEALTH_HOST:-$(detect_host_ip)}}"
  if endpoint_is_healthy "http://${status_host}:${DIRECT_PORT}/api/v1/health"; then
    ok "  Direct UI/API: healthy on ${status_host}:${DIRECT_PORT}"
  elif endpoint_is_healthy "http://${status_host}:${CONTROL_PLANE_PORT}/api/v1/health"; then
    ok "  Control-plane API: healthy on ${status_host}:${CONTROL_PLANE_PORT}"
  else
    error "  API unreachable on ports ${DIRECT_PORT} and ${CONTROL_PLANE_PORT} for ${status_host}"
  fi
}

# ---------------------------------------------------------------------------
# logs
# ---------------------------------------------------------------------------

cmd_logs() {
  require_docker
  local svc="${1:-control-plane}"
  local lines="${2:-100}"
  info "Tailing ${svc} logs (last ${lines} lines)..."
  docker service logs --tail "$lines" -f "${STACK_NAME}_${svc}"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

cmd_help() {
  cat <<EOF
Hive Platform Control Script

Usage: ./hivectl <command> [options]

Commands:
  install              Install Hive (idempotent)
  update [version]     Update Hive to a new version
  uninstall [--purge]  Remove the Hive stack
  status               Show stack status
  logs [service]       Tail service logs (default: control-plane)

Environment:
  HIVE_DOMAIN          Optional platform domain for HTTPS routing
  ACME_EMAIL           Let's Encrypt email when HIVE_DOMAIN is set
  HIVE_IMAGE_TAG       Image tag to deploy (default: latest)
  HIVE_CONTROL_PLANE_IMAGE
                      Control-plane image (default: ghcr.io/lukasparke/hive/control-plane)
  HIVE_AGENT_IMAGE     Agent image (default: ghcr.io/lukasparke/hive/agent)
  HIVE_DIRECT_PORT     Direct HTTP UI port for LAN/Cloudflare Tunnel (default: 8080)
  HIVE_CONTROL_PLANE_PORT
                      Direct control-plane port (default: 3000)
  HIVE_HEALTH_HOST     Host used for install/status health probes (default: detected swarm node IP)
  HIVE_STATUS_HOST     Optional override for status health probes
  HIVE_TRAEFIK_ENABLE  Enable Traefik domain routing (default: true when HIVE_DOMAIN is set)
  HIVE_STACK_FILE      Stack file path (default: deploy/hive-stack.yml)
  HIVE_STACK_URL       Stack file URL when running via curl pipe
  HIVE_STACK_NAME      Stack name (default: hive)

Examples:
  ./hivectl install
  HIVE_DOMAIN=hive.example.com ACME_EMAIL=admin@example.com ./hivectl install
  HIVE_DIRECT_PORT=8080 ./hivectl install
  ./hivectl update nightly
  ./hivectl update nightly-20250603-abc123
  ./hivectl uninstall --purge
  ./hivectl logs agent

EOF
}

main() {
  if [ $# -eq 0 ]; then
    cmd_help
    exit 1
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    install) cmd_install "$@" ;;
    update) cmd_update "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
      error "Unknown command: $cmd"
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
