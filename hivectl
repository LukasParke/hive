#!/usr/bin/env bash
set -euo pipefail

# Hive Platform Control Script
# Usage: ./hivectl <command> [options]
#
# Commands:
#   install      Install or re-install the Hive platform
#   update       Update Hive to a newer version
#   uninstall    Remove the Hive stack
#   install-cli  Install hivectl to PATH without deploying the stack
#   status       Show Hive stack status
#   logs         Tail control-plane logs
#
# Environment:
#   HIVE_DOMAIN             Optional domain for the platform (e.g. hive.example.com)
#   ACME_EMAIL              Email for Let's Encrypt certificates when HIVE_DOMAIN is set
#   HIVE_IMAGE_TAG          Image tag to deploy (default: latest)
#   HIVE_CONTROL_PLANE_IMAGE Control-plane image (default: ghcr.io/lukasparke/hive/control-plane)
#   HIVE_AGENT_IMAGE        Agent image (default: ghcr.io/lukasparke/hive/agent)
#   HIVE_DIRECT_PORT        Direct HTTP UI port for LAN/Cloudflare Tunnel (default: 8080)
#   HIVE_CONTROL_PLANE_PORT Direct control-plane port (default: 3000)
#   HIVE_HEALTH_HOST        Host used for install/status API probes (default: detected swarm node IP)
#   HIVE_TRAEFIK_ENABLE     Enable Traefik domain routing (default: true when HIVE_DOMAIN is set)
#   HIVE_HOST_MGMT          Enable agent host maintenance actions (default: false; preserved once enabled)
#   HIVE_ACME_DNS_PROVIDER  DNS provider for ACME DNS-01 (e.g. cloudflare) —
#                           required for wildcard certificates (*.example.com).
#                           When unset, Traefik keeps the default TLS-ALPN challenge.
#   HIVE_ACME_DNS_TOKEN     API token for the DNS provider; stored as the swarm
#                           secret 'hive-acme-dns-token'.
#   HIVE_INSTALL_CLI        Persist hivectl during install (default: true)
#   HIVE_CLI_PATH           Preferred CLI install path (default: /usr/local/bin/hivectl)
#   HIVE_STACK_FILE         Path to stack file (default: deploy/hive-stack.yml)
#   HIVE_STACK_URL          URL to stack file when running via curl pipe
#   HIVE_STACK_NAME         Docker stack name (default: hive)

SCRIPT_PATH="${BASH_SOURCE[0]:-}"
if [ -n "$SCRIPT_PATH" ] && [ -f "$SCRIPT_PATH" ]; then
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
else
  SCRIPT_DIR="$(pwd)"
fi

DEFAULT_STACK_FILE="${SCRIPT_DIR}/deploy/hive-stack.yml"
STACK_FILE="${HIVE_STACK_FILE:-$DEFAULT_STACK_FILE}"
HIVE_RAW_BASE="${HIVE_RAW_BASE:-https://raw.githubusercontent.com/LukasParke/hive/refs/heads/main}"
HIVE_STACK_URL="${HIVE_STACK_URL:-${HIVE_RAW_BASE}/deploy/hive-stack.yml}"
STACK_NAME="${HIVE_STACK_NAME:-hive}"
DIRECT_PORT="${HIVE_DIRECT_PORT:-8080}"
CONTROL_PLANE_PORT="${HIVE_CONTROL_PLANE_PORT:-3000}"
HIVE_HEALTH_HOST="${HIVE_HEALTH_HOST:-}"
TEMP_FILES=()

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() { echo -e "${BLUE}ℹ${NC}  $*"; }
ok() { echo -e "${GREEN}✓${NC}  $*"; }
warn() { echo -e "${YELLOW}⚠${NC}  $*" >&2; }
error() { echo -e "${RED}✗${NC}  $*" >&2; }

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

cmd_exists() { command -v "$1" >/dev/null 2>&1; }

cleanup() {
  if [ "${#TEMP_FILES[@]}" -gt 0 ]; then
    rm -f "${TEMP_FILES[@]}"
  fi
}
trap cleanup EXIT

read_prompt() {
  local var="$1" prompt="$2"
  if [ -r /dev/tty ]; then
    read -r -p "$prompt" "$var" </dev/tty
  else
    read -r -p "$prompt" "$var"
  fi
}

download_file() {
  local url="$1" dest="$2"
  if cmd_exists curl; then
    curl -fsSL "$url" -o "$dest"
  elif cmd_exists wget; then
    wget -qO "$dest" "$url"
  else
    error "curl or wget is required to download ${url}"
    return 1
  fi
}

path_contains_dir() {
  local dir="$1" part
  local -a parts
  IFS=':' read -r -a parts <<< "${PATH:-}"
  for part in "${parts[@]}"; do
    if [ "$part" = "$dir" ]; then
      return 0
    fi
  done
  return 1
}

write_executable_file() {
  local src="$1" dest="$2" dir
  dir="$(dirname "$dest")"
  if mkdir -p "$dir" 2>/dev/null && install -m 0755 "$src" "$dest" 2>/dev/null; then
    return 0
  fi
  return 1
}

install_hivectl_cli() {
  case "${HIVE_INSTALL_CLI:-true}" in
    false|False|FALSE|0|no|NO)
      info "Skipping hivectl CLI install because HIVE_INSTALL_CLI=${HIVE_INSTALL_CLI}"
      return 0
      ;;
  esac

  local tmp target target_dir fallback fallback_dir source_desc
  tmp="$(mktemp "${TMPDIR:-/tmp}/hivectl.XXXXXX")"
  TEMP_FILES+=("$tmp")

  if [ -n "$SCRIPT_PATH" ] && [ -f "$SCRIPT_PATH" ]; then
    cp "$SCRIPT_PATH" "$tmp"
    source_desc="$SCRIPT_PATH"
  else
    source_desc="${HIVE_RAW_BASE}/hivectl"
    if ! download_file "$source_desc" "$tmp"; then
      warn "Could not download hivectl for local CLI install; continuing stack install."
      return 0
    fi
  fi
  chmod +x "$tmp"

  target="${HIVE_CLI_PATH:-/usr/local/bin/hivectl}"
  target_dir="$(dirname "$target")"

  if write_executable_file "$tmp" "$target"; then
    ok "Installed hivectl CLI: ${target}"
    return 0
  fi

  if cmd_exists sudo && sudo -n true >/dev/null 2>&1; then
    if sudo mkdir -p "$target_dir" && sudo install -m 0755 "$tmp" "$target"; then
      ok "Installed hivectl CLI: ${target}"
      return 0
    fi
  fi

  if [ -n "${HOME:-}" ]; then
    fallback="${HOME}/.local/bin/hivectl"
    fallback_dir="$(dirname "$fallback")"
    if write_executable_file "$tmp" "$fallback"; then
      ok "Installed hivectl CLI: ${fallback}"
      if ! path_contains_dir "$fallback_dir"; then
        warn "${fallback_dir} is not in PATH. Add: export PATH=\"${fallback_dir}:\$PATH\""
      fi
      return 0
    fi
  fi

  warn "Could not install hivectl CLI from ${source_desc}. Re-run with HIVE_CLI_PATH set to a writable path or install manually."
}

# ensure_hive_buildkit runs the privileged host-level BuildKit container
# required by image builds (swarm services cannot get CAP_SYS_ADMIN, so
# buildkitd cannot run inside the stack). Idempotent.
ensure_hive_buildkit() {
  if docker ps --format '{{.Names}}' | grep -qx 'hive-buildkit'; then
    return 0
  fi
  step "Starting BuildKit (privileged host-level container)..."
  # buildkitd.toml: allow the plain-HTTP internal registry.
  mkdir -p /etc/hive
  printf '[registry."registry:5000"]\n  http = true\n  insecure = true\n' > /etc/hive/buildkitd.toml
  docker rm -f hive-buildkit >/dev/null 2>&1 || true
  docker network ls --format '{{.Name}}' | grep -qx 'hive_internal' || \
    docker network create --driver overlay --attachable hive_internal >/dev/null
  docker run -d --privileged --restart=unless-stopped \
    --name hive-buildkit \
    --network hive_internal --network-alias buildkit \
    -v /etc/hive/buildkitd.toml:/etc/buildkit/buildkitd.toml:ro \
    -v hive_buildkit-cache:/var/lib/buildkit \
    moby/buildkit:latest --addr tcp://0.0.0.0:1234 >/dev/null
  ok "BuildKit started"
}

ensure_stack_file() {
  if [ -f "$STACK_FILE" ]; then
    return 0
  fi

  if [ -n "${HIVE_STACK_FILE:-}" ]; then
    error "Stack file not found: ${STACK_FILE}"
    exit 1
  fi

  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/hive-stack.XXXXXX.yml")"
  TEMP_FILES+=("$tmp")

  info "Downloading stack file from ${HIVE_STACK_URL}"
  download_file "$HIVE_STACK_URL" "$tmp"
  STACK_FILE="$tmp"
}

# ---------------------------------------------------------------------------
# Wildcard certificates (DNS-01)
#
# HIVE_ACME_DNS_PROVIDER (e.g. cloudflare) plus HIVE_ACME_DNS_TOKEN switch
# Traefik's Let's Encrypt solver to the DNS-01 challenge, which is required to
# issue wildcard certificates (*.example.com). The token is stored as the
# swarm secret 'hive-acme-dns-token' and a generated compose overlay merges
# the DNS-01 flags and provider env into the traefik service at deploy time.
# Without HIVE_ACME_DNS_PROVIDER nothing changes (TLS-ALPN-01 as before).
# ---------------------------------------------------------------------------

ensure_acme_dns_overlay() {
  ACME_DNS_OVERLAY="${ACME_DNS_OVERLAY:-}"
  [ -n "$ACME_DNS_OVERLAY" ] && return 0
  if [ -z "${HIVE_ACME_DNS_PROVIDER:-}" ]; then
    return 0
  fi
  if [ -z "${HIVE_ACME_DNS_TOKEN:-}" ]; then
    error "HIVE_ACME_DNS_TOKEN is required when HIVE_ACME_DNS_PROVIDER is set"
    exit 1
  fi

  # Create or refresh the provider token secret. A secret in use by a running
  # service cannot be removed; keep the existing token in that case.
  if docker secret ls --format '{{.Name}}' | grep -qx 'hive-acme-dns-token'; then
    if docker secret rm hive-acme-dns-token >/dev/null 2>&1; then
      printf '%s' "$HIVE_ACME_DNS_TOKEN" | docker secret create hive-acme-dns-token - >/dev/null
      ok "Updated secret: hive-acme-dns-token"
    else
      warn "Secret hive-acme-dns-token is in use; keeping the existing token"
    fi
  else
    printf '%s' "$HIVE_ACME_DNS_TOKEN" | docker secret create hive-acme-dns-token - >/dev/null
    ok "Created secret: hive-acme-dns-token"
  fi

  local overlay
  overlay="$(mktemp "${TMPDIR:-/tmp}/hive-acme-dns.XXXXXX.yml")"
  TEMP_FILES+=("$overlay")
  cat >"$overlay" <<EOF
# Generated by hivectl: DNS-01 challenge overlay for wildcard certificates.
# Compose replaces command lists when merging, so this repeats the base
# traefik command from deploy/hive-stack.yml and appends the DNS-01 flags.
version: "3.9"

services:
  traefik:
    command:
      - --providers.swarm=true
      - --providers.swarm.exposedByDefault=false
      - --providers.swarm.network=hive_proxy
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --certificatesresolvers.letsencrypt.acme.email=\${ACME_EMAIL:-admin@example.invalid}
      - --certificatesresolvers.letsencrypt.acme.storage=/data/shared/acme.json
      - --certificatesresolvers.letsencrypt.acme.tlschallenge=true
      - --certificatesresolvers.letsencrypt.acme.dnschallenge=true
      - --certificatesresolvers.letsencrypt.acme.dnschallenge.provider=${HIVE_ACME_DNS_PROVIDER}
    environment:
      # Cloudflare reads its API token from CF_DNS_API_TOKEN_FILE. Other
      # providers need their own variables here instead (e.g. AWS_ACCESS_KEY_ID
      # / AWS_SECRET_ACCESS_KEY for route53, OVH_APPLICATION_KEY for ovh) —
      # see the lego DNS provider reference for the exact names.
      - CF_DNS_API_TOKEN_FILE=/run/secrets/acme-dns-token
    secrets:
      - source: acme-dns-token
        target: /run/secrets/acme-dns-token
secrets:
  acme-dns-token:
    external: true
EOF
  ACME_DNS_OVERLAY="$overlay"
  ok "DNS-01 overlay ready (${HIVE_ACME_DNS_PROVIDER})"
}

# deploy_stack deploys with the DNS-01 overlay merged in when a provider is
# configured, so update/host-management redeploys never silently drop it.
deploy_stack() {
  ensure_acme_dns_overlay
  if [ -n "${ACME_DNS_OVERLAY:-}" ]; then
    docker stack deploy -c "$STACK_FILE" -c "$ACME_DNS_OVERLAY" "$STACK_NAME"
  else
    docker stack deploy -c "$STACK_FILE" "$STACK_NAME"
  fi
}

require_docker() {
  if ! cmd_exists docker; then
    error "Docker is required but not installed."
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    error "Docker daemon is not running or you lack permissions."
    exit 1
  fi
}

swarm_active() {
  docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null | grep -q active
}

ensure_swarm() {
  if swarm_active; then
    ok "Docker Swarm is active"
    return 0
  fi
  info "Initializing Docker Swarm..."
  docker swarm init 2>/dev/null || docker swarm init --advertise-addr "$(hostname -i | awk '{print $1}')" 2>/dev/null || true
  if ! swarm_active; then
    error "Failed to initialize Docker Swarm"
    exit 1
  fi
  ok "Docker Swarm initialized"
}

stack_exists() {
  docker stack ls --format '{{.Name}}' 2>/dev/null | grep -qx "${STACK_NAME}"
}

service_image_tag() {
  local svc="$1"
  local img
  img=$(docker service inspect --format='{{.Spec.TaskTemplate.ContainerSpec.Image}}' "${STACK_NAME}_${svc}" 2>/dev/null || true)
  if [ -n "$img" ]; then
    echo "$img" | sed 's/.*://' | sed 's/@.*//'
  else
    echo "unknown"
  fi
}

service_env_value() {
  local svc="$1" key="$2"
  docker service inspect --format '{{range .Spec.TaskTemplate.ContainerSpec.Env}}{{println .}}{{end}}' "${STACK_NAME}_${svc}" 2>/dev/null \
    | awk -F= -v key="$key" '$1 == key {print $2; exit}'
}

preserve_host_mgmt_setting() {
  if [ -n "${HIVE_HOST_MGMT+x}" ]; then
    export HIVE_HOST_MGMT
    return 0
  fi
  local current
  current="$(service_env_value agent HOST_MGMT_ENABLED || true)"
  case "$current" in
    true|false)
      HIVE_HOST_MGMT="$current"
      export HIVE_HOST_MGMT
      ;;
  esac
}

node_has_label() {
  local node="$1" label="$2"
  docker node inspect --format "{{ index .Spec.Labels \"${label}\" }}" "$node" 2>/dev/null | grep -qx true
}

first_node_with_label() {
  local label="$1" node
  while read -r node; do
    [ -n "$node" ] || continue
    if node_has_label "$node" "$label"; then
      echo "$node"
      return 0
    fi
  done <<EOF_NODES
$(docker node ls --format '{{.Hostname}}')
EOF_NODES
  return 1
}

running_service_node() {
  local svc="$1"
  docker service ps "${STACK_NAME}_${svc}" --filter desired-state=running --format '{{.Node}}' 2>/dev/null | head -n 1
}

ensure_singleton_node_label() {
  local label="$1" service="$2" purpose="$3" target node
  target="$(running_service_node "$service" || true)"
  if [ -z "$target" ]; then
    target="$(first_node_with_label "$label" || true)"
  fi
  if [ -z "$target" ]; then
    target="$(docker node ls --format '{{.Hostname}}' | head -n 1)"
  fi
  if [ -z "$target" ]; then
    warn "No swarm node found for ${purpose} placement label ${label}=true"
    return 0
  fi

  while read -r node; do
    [ -n "$node" ] || continue
    if [ "$node" = "$target" ]; then
      docker node update --label-add "${label}=true" "$node" >/dev/null 2>&1 || true
    elif node_has_label "$node" "$label"; then
      docker node update --label-rm "$label" "$node" >/dev/null 2>&1 || true
    fi
  done <<EOF_NODES
$(docker node ls --format '{{.Hostname}}')
EOF_NODES
  ok "${purpose} pinned to node: ${target} (${label}=true)"
}

ensure_stateful_placement_labels() {
  info "Ensuring durable placement labels..."
  ensure_singleton_node_label db postgres "Postgres data"
  ensure_singleton_node_label registry registry "Registry data"

  local builder_node
  builder_node="$(running_service_node buildkit || true)"
  if [ -z "$builder_node" ]; then
    builder_node="$(first_node_with_label builder || true)"
  fi
  if [ -z "$builder_node" ]; then
    builder_node="$(docker node ls --format '{{.Hostname}}' | head -n 1)"
  fi
  if [ -n "$builder_node" ]; then
    docker node update --label-add builder=true "$builder_node" >/dev/null 2>&1 || true
    ok "BuildKit cache available on node: ${builder_node} (builder=true)"
  fi
}

release_legacy_traefik_direct_port() {
  local svc="${STACK_NAME}_traefik"
  if ! docker service inspect "$svc" >/dev/null 2>&1; then
    return 0
  fi

  local ports
  ports="$(docker service inspect --format '{{range .Endpoint.Spec.Ports}}{{printf "%d:%d/%s\n" .PublishedPort .TargetPort .Protocol}}{{end}}' "$svc" 2>/dev/null || true)"
  if ! printf '%s\n' "$ports" | grep -qx "${DIRECT_PORT}:8080/tcp"; then
    return 0
  fi

  warn "Repairing previous Traefik direct-port binding on :${DIRECT_PORT}"
  if docker service update --publish-rm 8080 "$svc" >/dev/null; then
    for ((i = 0; i < 30; i += 2)); do
      ports="$(docker service inspect --format '{{range .Endpoint.Spec.Ports}}{{printf "%d:%d/%s\n" .PublishedPort .TargetPort .Protocol}}{{end}}' "$svc" 2>/dev/null || true)"
      if ! printf '%s\n' "$ports" | grep -qx "${DIRECT_PORT}:8080/tcp"; then
        ok "Previous Traefik direct port released"
        return 0
      fi
      sleep 2
    done
  fi

  warn "Traefik still owns :${DIRECT_PORT}; removing ${svc} so stack deploy can recreate it cleanly"
  docker service rm "$svc" >/dev/null 2>&1 || true
  for ((i = 0; i < 30; i += 2)); do
    if ! docker service inspect "$svc" >/dev/null 2>&1; then
      ok "Removed stale Traefik service"
      return 0
    fi
    sleep 2
  done

  warn "Stale Traefik service still exists; deploy may report a port conflict"
}

prompt_required() {
  local var="$1" prompt="$2"
  if [ -z "${!var:-}" ]; then
    if ! read_prompt "$var" "$prompt: "; then
      error "$var is required"
      exit 1
    fi
    export "$var"
  fi
  if [ -z "${!var:-}" ]; then
    error "$var is required"
    exit 1
  fi
}

prompt_optional() {
  local var="$1" prompt="$2"
  if [ -z "${!var:-}" ]; then
    read_prompt "$var" "$prompt: " || true
    export "$var"
  fi
}

# is_lan_ip filters out loopback, link-local, and Docker's default bridge
# ranges, which are reachable only from the host itself.
is_lan_ip() {
  case "$1" in
    ""|0.0.0.0|"<no value>") return 1 ;;
    127.*|169.254.*|172.17.*|172.18.*|172.19.*|172.20.*|172.21.*|172.22.*|172.23.*|172.24.*|172.25.*|172.26.*|172.27.*|172.28.*|172.29.*|172.30.*|172.31.*) return 1 ;;
  esac
  return 0
}

detect_host_ip() {
  local ip
  ip="$(docker info --format '{{.Swarm.NodeAddr}}' 2>/dev/null || true)"
  if is_lan_ip "$ip"; then
    echo "$ip"
    return 0
  fi

  ip="$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}' || true)"
  if is_lan_ip "$ip"; then
    echo "$ip"
    return 0
  fi

  for ip in $(hostname -I 2>/dev/null || true); do
    if is_lan_ip "$ip"; then
      echo "$ip"
      return 0
    fi
  done

  ip="$(hostname -i 2>/dev/null | awk '{print $1}' || true)"
  if [ -z "$ip" ] || [ "$ip" = "127.0.0.1" ]; then
    ip="localhost"
  fi
  echo "$ip"
}

print_stack_diagnostics() {
  warn "Hive did not become healthy. Docker service diagnostics:"
  docker service ls --filter "label=com.docker.stack.namespace=${STACK_NAME}" || true
  echo ""
  for svc in control-plane agent traefik postgres; do
    if docker service inspect "${STACK_NAME}_${svc}" >/dev/null 2>&1; then
      echo "=== ${STACK_NAME}_${svc} tasks ==="
      docker service ps --no-trunc "${STACK_NAME}_${svc}" || true
      echo ""
    fi
  done
  warn "Common causes: image pull failures, unhealthy database startup, occupied ports, or missing Swarm labels."
  warn "Try: docker service logs ${STACK_NAME}_control-plane --tail 100"
}

normalize_image_tag() {
  local tag="$1"
  if [ -z "$tag" ]; then
    printf '%s' ""
    return 0
  fi
  if [[ "$tag" == v* ]]; then
    printf '%s' "${tag#v}"
    return 0
  fi
  printf '%s' "$tag"
}

probe_endpoint() {
  local url="$1" timeout_sec="${2:-3}"

  if cmd_exists curl; then
    local raw status body
    raw="$(curl -sS --max-time "$timeout_sec" -w '\n%{http_code}' "$url" 2>/dev/null || true)"
    status="${raw##*$'\n'}"
    body="${raw%$'\n'${status}}"
    status="${status//$'\r'/}"
    printf '%s|%s' "$status" "$body"
    return 0
  fi

  if cmd_exists wget; then
    local body_file header_file status body
    body_file="$(mktemp "${TMPDIR:-/tmp}/hive-health-body.XXXXXX")"
    header_file="$(mktemp "${TMPDIR:-/tmp}/hive-health-headers.XXXXXX")"
    wget -q -S --timeout "$timeout_sec" -O "$body_file" "$url" 2>"$header_file" || true
    status="$(awk '/^  HTTP/{print $2}' "$header_file" | tail -n 1)"
    body="$(cat "$body_file")"
    status="${status//$'\r'/}"
    rm -f "$body_file" "$header_file"
    printf '%s|%s' "$status" "$body"
    return 0
  fi

  warn "curl or wget is required to probe endpoints"
  return 1
}

wait_for_health() {
  local url="$1" timeout_sec="${2:-120}" fail_fast_on_404="${3:-0}"
  info "Waiting for ${url} (timeout: ${timeout_sec}s)..."

  for ((i = 0; i < timeout_sec; i += 2)); do
    local probe status body
    probe="$(probe_endpoint "$url" 2 || true)"
    status="${probe%%|*}"
    body="${probe#*|}"

    if [ "$status" = "200" ] && [[ "$body" == *'"status":"ok"'* ]]; then
      ok "Service is healthy"
      return 0
    fi

    if [ "$status" = "404" ] && [ "$fail_fast_on_404" -eq 1 ]; then
      warn "Endpoint ${url} is returning HTTP 404. This often means the request is reaching the wrong service or missing Traefik routing."
      return 2
    fi

    sleep 2
  done

  warn "Health check timed out after ${timeout_sec}s for ${url}"
  return 1
}

endpoint_is_healthy() {
  local url="$1" timeout_sec="${2:-3}"

  local probe status body
  probe="$(probe_endpoint "$url" "$timeout_sec" || true)"
  status="${probe%%|*}"
  body="${probe#*|}"

  if [ "$status" = "200" ] && [[ "$body" == *'"status":"ok"'* ]]; then
    return 0
  fi
  return 1
}

wait_for_hive_health() {
  local host="${1:-${HIVE_HEALTH_HOST:-localhost}}"
  local direct_url="http://${host}:${DIRECT_PORT}/api/v1/health"
  local control_url="http://${host}:${CONTROL_PLANE_PORT}/api/v1/health"

  wait_for_health "$direct_url" 120 1
  HIVE_DIRECT_HEALTH_CHECK_STATUS=$?

  if [ "$HIVE_DIRECT_HEALTH_CHECK_STATUS" -eq 0 ]; then
    return 0
  fi

  wait_for_health "$control_url" 30 0
  HIVE_CONTROL_HEALTH_CHECK_STATUS=$?
  if [ "$HIVE_CONTROL_HEALTH_CHECK_STATUS" -eq 0 ]; then
    return 0
  fi

  print_stack_diagnostics
  return "$HIVE_CONTROL_HEALTH_CHECK_STATUS"
}

print_swarm_join_commands() {
  local mgr_token worker_token node_addr
  mgr_token="$(docker swarm join-token manager -q 2>/dev/null || true)"
  worker_token="$(docker swarm join-token worker -q 2>/dev/null || true)"
  if [ -z "$mgr_token" ] && [ -z "$worker_token" ]; then
    return 0
  fi
  node_addr="${HIVE_HEALTH_HOST:-$(docker info --format '{{.Swarm.NodeAddr}}' 2>/dev/null || true)}"
  info "Grow the cluster by running on additional nodes:"
  if [ -n "$mgr_token" ]; then
    info "  Manager: docker swarm join --token ${mgr_token} ${node_addr:-<manager-ip>}:2377"
  fi
  if [ -n "$worker_token" ]; then
    info "  Worker:  docker swarm join --token ${worker_token} ${node_addr:-<manager-ip>}:2377"
  fi
}

# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------

cmd_install() {
  install_hivectl_cli
  require_docker
  ensure_swarm

  prompt_optional "HIVE_DOMAIN" "Platform domain (optional; press Enter for direct-port only)"
  if [ -n "${HIVE_DOMAIN:-}" ]; then
    prompt_required "ACME_EMAIL" "Email for Let's Encrypt certificates"
    HIVE_TRAEFIK_ENABLE="${HIVE_TRAEFIK_ENABLE:-true}"
  else
    ACME_EMAIL="${ACME_EMAIL:-admin@example.invalid}"
    HIVE_TRAEFIK_ENABLE="${HIVE_TRAEFIK_ENABLE:-false}"
    export ACME_EMAIL
    warn "No HIVE_DOMAIN set; Hive will be available on the direct HTTP port only."
  fi
  export HIVE_TRAEFIK_ENABLE

  # Create secrets
  info "Ensuring secrets exist..."
  create_secret() {
    local name="$1"
    if ! docker secret ls --format '{{.Name}}' | grep -qx "${name}"; then
      local value
      value="$(openssl rand -hex 32)"
      printf '%s' "$value" | docker secret create "$name" -
      ok "Created secret: ${name}"
    else
      ok "Secret exists: ${name}"
    fi
  }

  create_secret "hive-master-key"
  create_secret "postgres-password"
  create_secret "hive-jwt-secret"
  create_secret "agent-bootstrap-token"

  # Create overlay networks the stack references as external. Creating them
  # here keeps their names stable regardless of the stack name, which Traefik
  # and the control-plane rely on.
  info "Ensuring networks exist..."
  ensure_network() {
    local name="$1"; shift
    if ! docker network ls --format '{{.Name}}' | grep -qx "${name}"; then
      docker network create --driver overlay --attachable "$@" "$name" >/dev/null
      ok "Created network: ${name}"
    else
      ok "Network exists: ${name}"
    fi
  }

  ensure_network "hive_internal" --opt encrypted=true
  ensure_network "hive_proxy"

  # Pin stateful services to their existing nodes when possible. Swarm named
  # volumes are node-local by default; allowing Postgres or the registry to
  # reschedule onto another node makes the app look freshly installed.
  ensure_stateful_placement_labels

  # Normalize optional tag (docs historically mix v-prefixed and unprefixed release names)
  if [ -n "${HIVE_IMAGE_TAG:-}" ]; then
    HIVE_IMAGE_TAG="$(normalize_image_tag "$HIVE_IMAGE_TAG")"
  fi

  # BuildKit cannot run as a swarm service (services lack CAP_SYS_ADMIN;
  # buildkitd needs mount(2)). Run it as a privileged host-level container
  # on this builder node, aliased as 'buildkit' on hive_internal.
  ensure_hive_buildkit
  # Deploy stack
  ensure_stack_file
  preserve_host_mgmt_setting
  release_legacy_traefik_direct_port
  info "Deploying stack with image tag: ${HIVE_IMAGE_TAG:-latest}..."
  deploy_stack
  ok "Stack deployed"

  # Wait for health
  local health_host
  health_host="${HIVE_HEALTH_HOST:-$(detect_host_ip)}"
  if ! wait_for_hive_health "$health_host"; then
    error "Hive was deployed but did not become healthy. See diagnostics above."
    error "Once fixed, re-run this install — it is idempotent."
    exit 1
  fi

  info ""
  ok "Hive is installed!"
  info "  Control-plane API health: http://${health_host}:${CONTROL_PLANE_PORT}/api/v1/health"

  if [ "${HIVE_DIRECT_HEALTH_CHECK_STATUS:-1}" -eq 0 ]; then
    info "  Direct UI: http://${health_host}:${DIRECT_PORT}"
    info "  Direct health: http://${health_host}:${DIRECT_PORT}/api/v1/health"
    if [ -n "${HIVE_DOMAIN:-}" ]; then
      info "  Admin signup: https://${HIVE_DOMAIN}/register"
      info "  Admin signup (direct): http://${health_host}:${DIRECT_PORT}/register"
    else
      info "  Admin signup: http://${health_host}:${DIRECT_PORT}/register"
    fi
  else
    warn "  Direct port ${DIRECT_PORT} is not currently serving Hive"
    warn "    - check any existing service on :${DIRECT_PORT} and port exposure on this host"
    info "  Fallback UI/API: http://${health_host}:${CONTROL_PLANE_PORT}"
    info "  Admin signup: http://${health_host}:${CONTROL_PLANE_PORT}/register"
  fi
  info "  Cloudflare Tunnel target: http://localhost:${DIRECT_PORT}"
  if [ "${HIVE_HOST_MGMT:-false}" = "true" ]; then
    warn "  Host management is ENABLED: node maintenance actions can run package upgrades/reboots via the agent."
  else
    info "  Host management: disabled (enable with HIVE_HOST_MGMT=true ./hivectl update latest)"
  fi
  if [ -n "${HIVE_DOMAIN:-}" ]; then
    info "  Domain URL: https://${HIVE_DOMAIN}"
    info "  Admin signup (domain): https://${HIVE_DOMAIN}/register"
  fi
  print_swarm_join_commands
}

# ---------------------------------------------------------------------------
# update
# ---------------------------------------------------------------------------

cmd_update() {
  require_docker

  if ! stack_exists; then
    error "Stack '${STACK_NAME}' is not deployed. Run './hivectl install' first."
    exit 1
  fi

  local current_cp current_agent new_tag
  current_cp="$(service_image_tag "control-plane")"
  current_agent="$(service_image_tag "agent")"

  info "Current versions:"
  info "  control-plane: ${current_cp}"
  info "  agent:         ${current_agent}"

  # Determine target version
  if [ -n "${HIVE_IMAGE_TAG:-}" ]; then
    new_tag="$(normalize_image_tag "$HIVE_IMAGE_TAG")"
    info "Using HIVE_IMAGE_TAG from environment: ${new_tag}"
  elif [ $# -gt 0 ]; then
    new_tag="$(normalize_image_tag "$1")"
    shift
  else
    # Try to fetch latest release from GitHub
    info "Checking GitHub for latest release..."
    new_tag=$(curl -sfL \
      -H "Accept: application/vnd.github+json" \
      "https://api.github.com/repos/LukasParke/hive/releases/latest" 2>/dev/null \
      | grep '"tag_name":' | sed -E 's/.*"tag_name": "([^"]+)".*/\1/') || true
    new_tag="$(normalize_image_tag "$new_tag")"

    if [ -n "$new_tag" ] && [ "$new_tag" != "null" ]; then
      info "Latest release: ${new_tag}"
    else
      warn "Could not fetch latest release from GitHub."
      if ! read_prompt new_tag "Enter image tag to update to (default: latest): "; then
        new_tag=""
      fi
      new_tag="$(normalize_image_tag "${new_tag:-latest}")"
    fi
  fi

  if [ "$current_cp" = "$new_tag" ] && [ "$current_agent" = "$new_tag" ]; then
    ok "Already running ${new_tag}"
    return 0
  fi

  info "Updating to ${new_tag}..."
  ensure_stack_file
  preserve_host_mgmt_setting
  ensure_stateful_placement_labels
  HIVE_IMAGE_TAG="$new_tag" deploy_stack
  ok "Stack update triggered"

  # Wait for rollout
  info "Waiting for services to update..."
  for svc in control-plane agent; do
    info "  Waiting for ${svc}..."
    local attempts=0
    while [ $attempts -lt 60 ]; do
      local running desired
      running=$(docker service ps "${STACK_NAME}_${svc}" --format '{{.CurrentState}}' 2>/dev/null | grep -c 'Running' || true)
      desired=$(docker service inspect --format='{{.Spec.Mode.Replicated.Replicas}}' "${STACK_NAME}_${svc}" 2>/dev/null || echo "1")
      if [ "$svc" = "agent" ]; then
        desired=$(docker node ls --format '{{.ID}}' | wc -l)
      fi
      if [ "$running" -ge "$desired" ] 2>/dev/null; then
        ok "  ${svc} is running (${running}/${desired})"
        break
      fi
      attempts=$((attempts + 1))
      sleep 2
    done
    if [ $attempts -ge 60 ]; then
      warn "  ${svc} rollout timed out — check 'docker service ps ${STACK_NAME}_${svc}'"
    fi
  done

  ok "Update complete"
}

# ---------------------------------------------------------------------------
# host-management
# ---------------------------------------------------------------------------

cmd_host_management() {
  require_docker
  local action="${1:-status}"
  case "$action" in
    status)
      local current
      current="$(service_env_value agent HOST_MGMT_ENABLED || true)"
      if [ "$current" = "true" ]; then
        ok "Host management is enabled on ${STACK_NAME}_agent"
      else
        info "Host management is disabled on ${STACK_NAME}_agent"
      fi
      ;;
    enable|on|true)
      ensure_stack_file
      HIVE_HOST_MGMT=true
      export HIVE_HOST_MGMT
      warn "Enabling host management allows node package maintenance and reboot scheduling through Hive."
      deploy_stack
      ok "Host management enabled; agent rollout triggered"
      ;;
    disable|off|false)
      ensure_stack_file
      HIVE_HOST_MGMT=false
      export HIVE_HOST_MGMT
      deploy_stack
      ok "Host management disabled; agent rollout triggered"
      ;;
    *)
      error "Usage: ./hivectl host-management [status|enable|disable]"
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------

cmd_uninstall() {
  require_docker

  local purge=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge) purge=true; shift ;;
      *) break ;;
    esac
  done

  if ! stack_exists; then
    warn "Stack '${STACK_NAME}' does not exist"
    return 0
  fi

  if ! read_prompt confirm "Remove stack '${STACK_NAME}'? [y/N] "; then
    confirm=""
  fi
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    info "Cancelled"
    exit 0
  fi

  info "Removing stack '${STACK_NAME}'..."
  docker stack rm "$STACK_NAME" || true

  # Wait for stack removal
  local attempts=0
  while stack_exists && [ $attempts -lt 30 ]; do
    sleep 2
    attempts=$((attempts + 1))
  done

  if [ "$purge" = true ]; then
    warn "Purging volumes and secrets..."
    for vol in pgdata shared buildkit-cache registry-data agent-certs; do
      docker volume rm "${STACK_NAME}_${vol}" 2>/dev/null || true
    done
    for secret in hive-master-key postgres-password hive-jwt-secret agent-bootstrap-token; do
      docker secret rm "$secret" 2>/dev/null || true
    done
    for net in hive_internal hive_proxy; do
      docker network rm "$net" 2>/dev/null || true
    done
    ok "Purge complete"
  else
    info "Volumes and secrets preserved. Use --purge to remove them."
  fi

  ok "Hive uninstalled"
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

cmd_status() {
  require_docker

  if ! stack_exists; then
    warn "Stack '${STACK_NAME}' is not deployed"
    return 0
  fi

  echo ""
  echo "=== Stack: ${STACK_NAME} ==="
  echo ""

  echo "Services:"
  docker stack ps "$STACK_NAME" --format 'table {{.Name}}	{{.CurrentState}}	{{.Error}}' 2>/dev/null || true

  echo ""
  echo "Images:"
  local cp_tag agent_tag
  cp_tag="$(service_image_tag "control-plane")"
  agent_tag="$(service_image_tag "agent")"
  echo "  control-plane: ${cp_tag}"
  echo "  agent:         ${agent_tag}"

  echo ""
  echo "Durability:"
  local host_mgmt
  host_mgmt="$(service_env_value agent HOST_MGMT_ENABLED || true)"
  echo "  stack name: ${STACK_NAME}"
  echo "  postgres volume: ${STACK_NAME}_pgdata (preserved unless uninstall --purge or docker volume rm/prune)"
  echo "  host management: ${host_mgmt:-false}"

  echo ""
  echo "Health:"
  local status_host
  status_host="${HIVE_STATUS_HOST:-${HIVE_HEALTH_HOST:-$(detect_host_ip)}}"
  if endpoint_is_healthy "http://${status_host}:${DIRECT_PORT}/api/v1/health"; then
    ok "  Direct UI/API: healthy on ${status_host}:${DIRECT_PORT}"
  elif endpoint_is_healthy "http://${status_host}:${CONTROL_PLANE_PORT}/api/v1/health"; then
    ok "  Control-plane API: healthy on ${status_host}:${CONTROL_PLANE_PORT}"
  else
    error "  API unreachable on ports ${DIRECT_PORT} and ${CONTROL_PLANE_PORT} for ${status_host}"
  fi
}

# ---------------------------------------------------------------------------
# logs
# ---------------------------------------------------------------------------

cmd_logs() {
  require_docker
  local svc="${1:-control-plane}"
  local lines="${2:-100}"
  info "Tailing ${svc} logs (last ${lines} lines)..."
  docker service logs --tail "$lines" -f "${STACK_NAME}_${svc}"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

cmd_help() {
  cat <<EOF
Hive Platform Control Script

Usage: ./hivectl <command> [options]

Commands:
  install              Install Hive (idempotent)
  update [version]     Update Hive to a new version
  uninstall [--purge]  Remove the Hive stack
  host-management      Show/enable/disable host maintenance actions
  install-cli          Install/update the hivectl CLI on this host
  status               Show stack status
  logs [service]       Tail service logs (default: control-plane)

Environment:
  HIVE_DOMAIN          Optional platform domain for HTTPS routing
  ACME_EMAIL           Let's Encrypt email when HIVE_DOMAIN is set
  HIVE_IMAGE_TAG       Image tag to deploy (default: latest)
  HIVE_CONTROL_PLANE_IMAGE
                      Control-plane image (default: ghcr.io/lukasparke/hive/control-plane)
  HIVE_AGENT_IMAGE     Agent image (default: ghcr.io/lukasparke/hive/agent)
  HIVE_DIRECT_PORT     Direct HTTP UI port for LAN/Cloudflare Tunnel (default: 8080)
  HIVE_CONTROL_PLANE_PORT
                      Direct control-plane port (default: 3000)
  HIVE_HEALTH_HOST     Host used for install/status health probes (default: detected swarm node IP)
  HIVE_STATUS_HOST     Optional override for status health probes
  HIVE_TRAEFIK_ENABLE  Enable Traefik domain routing (default: true when HIVE_DOMAIN is set)
  HIVE_HOST_MGMT       Enable agent host package/reboot actions (default: false; preserved once enabled)
  HIVE_INSTALL_CLI     Persist hivectl during install (default: true)
  HIVE_CLI_PATH        Preferred CLI path (default: /usr/local/bin/hivectl; falls back to ~/.local/bin)
  HIVE_STACK_FILE      Stack file path (default: deploy/hive-stack.yml)
  HIVE_STACK_URL       Stack file URL when running via curl pipe
  HIVE_STACK_NAME      Stack name (default: hive)

Examples:
  ./hivectl install
  HIVE_DOMAIN=hive.example.com ACME_EMAIL=admin@example.com ./hivectl install
  HIVE_DIRECT_PORT=8080 ./hivectl install
  ./hivectl update nightly
  ./hivectl update nightly-20250603-abc123
  ./hivectl host-management enable
  HIVE_HOST_MGMT=true ./hivectl update latest
  ./hivectl install-cli
  ./hivectl uninstall --purge
  ./hivectl logs agent

EOF
}

main() {
  if [ $# -eq 0 ]; then
    cmd_help
    exit 1
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    install) cmd_install "$@" ;;
    update) cmd_update "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    host-management|host_mgmt|host-mgmt) cmd_host_management "$@" ;;
    install-cli|self-install) install_hivectl_cli "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
      error "Unknown command: $cmd"
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
